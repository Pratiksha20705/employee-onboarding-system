# Copy this file to .env (or export these as real environment variables)
# and fill in real values. Never commit actual secrets.

# MySQL connection
DB_URL=jdbc:mysql://localhost:3306/onboardflow_db
DB_USERNAME=root
DB_PASSWORD=change-me

# JWT signing secret — use a long, random string in any shared/deployed environment
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRATION_MS=86400000

# Comma-separated list of origins allowed to call the API
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Seeded HR account created on first boot if it doesn't already exist
APP_SEED_HR_EMAIL=hr@onboardflow.com
APP_SEED_HR_PASSWORD=change-me

# Seeded demo candidate account + onboarding profile created on first boot if it doesn't already exist
APP_SEED_CANDIDATE_EMAIL=candidate@onboardflow.com
APP_SEED_CANDIDATE_PASSWORD=change-me
